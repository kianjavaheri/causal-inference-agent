# ---- Secrets -------------------------------------------------------------
# Broad match first, then re-include the checked-in templates. Order matters:
# a negation only works after the pattern that excluded the file.
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.env.example

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# ---- Node / Next.js ------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Deploy --------------------------------------------------------------
.vercel/
*.pem

# ---- Editors & OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- Claude Code ---------------------------------------------------------
# .claude/launch.json is shared project config and stays tracked; per-user
# permission settings do not.
.claude/settings.local.json
