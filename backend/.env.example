# Optional. Without it the agent runs in rule-based mode: the identifiability engine
# still chooses the design and the report is generated from a template.
ANTHROPIC_API_KEY=

# Planning is the hard reasoning step; reporting is mostly writing.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_REPORT_MODEL=claude-sonnet-5

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=http://localhost:3000

# Upload guards.
MAX_UPLOAD_BYTES=26214400
MAX_ROWS=250000
SESSION_TTL_SECONDS=14400
